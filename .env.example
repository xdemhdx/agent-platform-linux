# Optional compose settings. Copy this file to .env and adjust if needed.

COMPOSE_PROJECT_NAME=agent-platform-linux
BASE_IMAGE_NAME=agent-platform-linux-base
NODE_MAJOR=22
CODEX_NPM_PACKAGE=@openai/codex
AGENT_CPU_LIMIT=2.0
AGENT_MEMORY_LIMIT=2g
TZ=UTC

# Do not put secrets here unless you explicitly want docker compose to load them.
# Recommended: sign in interactively inside each container so Azure CLI and Codex
# store session state in the mounted folders under each environment.
